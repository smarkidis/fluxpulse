{
  "model": {
    "type": "generic_qubit",
    "omega": 0.0,
    "detuning": 0.0,
    "t1": 0,
    "tphi": 0
  },
  "initial_state": {
    "type": "basis",
    "index": 0
  },
  "run": {
    "trajectories": 1,
    "base_seed": 12345,
    "sample_stride": 1,
    "renormalize_each_step": true
  },
  "program": {
    "grid": {
      "t0": 0.0,
      "dt": 0.0125,
      "n_steps": 80
    },
    "pulses": [
      {
        "channel": "drive_x",
        "envelope": {
          "type": "piecewise_constant",
          "segments": [
            {
              "t0": 0.0,
              "t1": 1.0,
              "value": 10.0
            }
          ]
        }
      }
    ]
  },
  "observables": [
    "P1",
    "Z"
  ],
  "output": {
    "result_path": "out/convergence/rk4_h0p0125_result.json",
    "write_trace": false,
    "trace_path": "out/convergence/rk4_h0p0125_trace.json"
  },
  "trace": {
    "emit_segments": true,
    "emit_counters": true,
    "counter_stride": 10,
    "time_scale_to_us": 1.0
  }
}
