{
  "model": {
    "type": "coupled_qubits",
    "nqubits": 2,
    "omega": [
      0.0,
      0.0
    ],
    "detuning": [
      0.0,
      0.0
    ],
    "t1": [
      2.5,
      2.5
    ],
    "tphi": [
      4.0,
      4.0
    ],
    "enable_drive_x": true,
    "enable_drive_y": false,
    "enable_drive_z": false,
    "exchange_xy": [
      {
        "q0": 0,
        "q1": 1,
        "strength": 0.9
      }
    ],
    "zz": [
      {
        "q0": 0,
        "q1": 1,
        "strength": 0.06
      }
    ]
  },
  "initial_state": "ground",
  "program": {
    "grid": {
      "t0": 0.0,
      "dt": 0.001,
      "n_points": 2001
    },
    "pulses": [
      {
        "channel": "drive_x0",
        "envelope": {
          "type": "piecewise_constant",
          "segments": [
            {
              "t0": 0.0,
              "t1": 0.0157079633,
              "value": 200.0
            },
            {
              "t0": 0.0157079633,
              "t1": 2.0,
              "value": 0.0
            }
          ]
        }
      },
      {
        "channel": "drive_x1",
        "envelope": {
          "type": "piecewise_constant",
          "segments": [
            {
              "t0": 0.0,
              "t1": 2.0,
              "value": 0.0
            }
          ]
        }
      }
    ]
  },
  "run": {
    "trajectories": 1,
    "base_seed": 12345,
    "sample_stride": 1,
    "renormalize_each_step": true
  },
  "observables": [
    "P:10",
    "P:01",
    "P:00",
    "Z0",
    "Z1"
  ],
  "output": {
    "result_path": "out/2q_transport_result.json",
    "write_trace": true,
    "trace_path": "out/2q_transport_trace.json"
  },
  "trace": {
    "emit_segments": true,
    "emit_counters": true,
    "counter_stride": 5,
    "time_scale_to_us": 1000.0
  }
}